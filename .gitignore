# Rust build artifacts
/target/
/bindings/*/target/
/bindings/wasm/pkg/
debug/
*.pdb

# The workspace lock keeps binding builds reproducible.
!/Cargo.lock

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test files
*.pdf
!tests/fixtures/*.pdf

# Build cache
**/*.rs.bk

# Node generated files (regenerated by `napi prepublish` during CI)
bindings/node/index.js
bindings/node/index.d.ts

# Local samples and scripts
samples/
scripts/

# Test output
test_output/

# Python
__pycache__/
*.pyc
.pytest_cache/
