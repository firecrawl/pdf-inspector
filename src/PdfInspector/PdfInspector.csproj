<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PdfInspector</RootNamespace>
    <AssemblyName>PdfInspector</AssemblyName>
    <PackageId>PdfInspector</PackageId>
    <Description>Fast PDF inspection, classification, and text extraction with smart scanned vs text-based detection.</Description>
    <Version>0.1.0</Version>
    <Authors>Firecrawl Team</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test suite covers the internal heuristics directly, mirroring the
         Rust crate's in-module unit tests. -->
    <InternalsVisibleTo Include="PdfInspector.Tests" />

    <!-- The benchmark harness times individual pipeline stages, which are
         internal; the shipping path stays free of measurement hooks. -->
    <InternalsVisibleTo Include="pdf-inspector-bench" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled Adobe CMap binaries, loaded at runtime by the ToUnicode layer. -->
    <EmbeddedResource Include="..\..\reference\external\bcmaps\*.bcmap">
      <LogicalName>bcmaps/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
