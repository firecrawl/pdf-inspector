<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuildPdfInspectorNative Condition="'$(BuildPdfInspectorNative)' == ''">true</BuildPdfInspectorNative>
    <PdfInspectorNativeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../native'))</PdfInspectorNativeRoot>
    <PdfInspectorNativeProfile Condition="'$(Configuration)' == 'Release'">release</PdfInspectorNativeProfile>
    <PdfInspectorNativeProfile Condition="'$(PdfInspectorNativeProfile)' == ''">debug</PdfInspectorNativeProfile>
    <PdfInspectorCargoFlags Condition="'$(Configuration)' == 'Release'">--release</PdfInspectorCargoFlags>
    <PdfInspectorNativeFile Condition="'$(OS)' == 'Windows_NT'">pdf_inspector_dotnet.dll</PdfInspectorNativeFile>
    <PdfInspectorNativeFile Condition="'$(OS)' != 'Windows_NT' and $([MSBuild]::IsOSPlatform('OSX'))">libpdf_inspector_dotnet.dylib</PdfInspectorNativeFile>
    <PdfInspectorNativeFile Condition="'$(PdfInspectorNativeFile)' == ''">libpdf_inspector_dotnet.so</PdfInspectorNativeFile>
    <PdfInspectorNativePath>$(PdfInspectorNativeRoot)/target/$(PdfInspectorNativeProfile)/$(PdfInspectorNativeFile)</PdfInspectorNativePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Firecrawl.PdfInspector\Firecrawl.PdfInspector.csproj" />
    <None Include="..\..\..\tests\fixtures\thermo-freon12.pdf" Link="fixtures\thermo-freon12.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\tests\fixtures\scan_with_native_header_text.pdf" Link="fixtures\scan_with_native_header_text.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildPdfInspectorNativeLibrary"
          BeforeTargets="Build"
          Condition="'$(BuildPdfInspectorNative)' == 'true' and '$(OS)' != 'Windows_NT'">
    <Message Importance="high" Text="Building native pdf-inspector test library ($(PdfInspectorNativeProfile))..." />
    <Exec Command="cargo build $(PdfInspectorCargoFlags) --locked --manifest-path &quot;$(PdfInspectorNativeRoot)/Cargo.toml&quot;" />
  </Target>

  <Target Name="BuildPdfInspectorNativeLibraryWindows"
          BeforeTargets="Build"
          Condition="'$(BuildPdfInspectorNative)' == 'true' and '$(OS)' == 'Windows_NT'">
    <Message Importance="high" Text="Building native pdf-inspector test library ($(PdfInspectorNativeProfile))..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build-native.ps1&quot; -Configuration $(Configuration)" />
  </Target>

  <Target Name="CopyPdfInspectorNativeLibrary"
          AfterTargets="Build"
          Condition="'$(BuildPdfInspectorNative)' == 'true'">
    <Error Condition="!Exists('$(PdfInspectorNativePath)')"
           Text="Native pdf-inspector library was not produced at $(PdfInspectorNativePath)." />
    <Copy SourceFiles="$(PdfInspectorNativePath)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
